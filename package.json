{
  "name": "rooki2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,STT -c green,cyan \"vite\" \"C:\\Users\\mirun\\AppData\\Local\\Programs\\Python\\Python313\\python.exe stt_server.py\"",
    "dev:vite": "vite",
    "dev:stt": "C:\\Users\\mirun\\AppData\\Local\\Programs\\Python\\Python313\\python.exe stt_server.py",
    "dev:desktop": "ROOKI_DEV=1 concurrently -k -n VITE,STT,AGENT,ELECTRON -c green,cyan,yellow,magenta \"vite\" \"C:\\Users\\mirun\\AppData\\Local\\Programs\\Python\\Python313\\python.exe stt_server.py\" \"node tools/agent/server.mjs\" \"electron .\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "agent": "node tools/agent/server.mjs",
    "desktop": "electron .",
    "desktop:build": "electron-builder"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "electron": "^28.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.rooki.desktop",
    "productName": "ROOKI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/kokoro_tts.py",
      "tools/venv/**/*",
      "stt_server.py",
      "tools/agent/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ROOKI"
    }
  }
}
